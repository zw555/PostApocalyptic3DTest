; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="After Hours | 3D Art Validation"
config/description="Procedural low-poly abandoned convenience store. WASD / F1-F4."
run/main_scene="res://scenes/combat/stage5c2_melee_validation.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")

[display]

window/size/viewport_width=1440
window/size/viewport_height=1000
window/size/window_width_override=1296
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[layer_names]

3d_physics/layer_1="Architecture and furniture"
3d_physics/layer_2="Survivor"

[physics]

3d/physics_engine="GodotPhysics3D"

[rendering]

lights_and_shadows/directional_shadow/size=2048
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.055, 0.073, 0.083, 1)
lights_and_shadows/positional_shadow/atlas_size=2048
