extends SceneTree
const DB = preload("res://scripts/items/item_database.gd")
const Inventory = preload("res://scripts/items/inventory_model.gd")
var checks: Array = []
func check(label: String, passed: bool) -> void:
	checks.append({"label":label,"passed":passed})
	print("PASS " if passed else "FAIL ",label)
func _initialize() -> void: call_deferred("run")
func run() -> void:
	var db := DB.new()
	var catalog = load("res://data/items/catalog.tres")
	check("six unique definition IDs",db.configure(catalog).ok and db.ids().size()==6)
	var expected := {"water_bottle":[1,5],"canned_food":[1,5],"bandage":[1,5],"battery":[2,10],"combat_knife":[0,1],"baseball_bat":[0,1]}
	for id in expected:
		var definition = db.definition(id)
		check("definition category/limit "+id,definition.category==expected[id][0] and definition.max_stack==expected[id][1])
	var copy = db.definition("water_bottle")
	copy.max_stack = 99
	check("definition query cannot mutate catalog",db.stack_limit("water_bottle")==5)
	var bad = catalog.duplicate()
	bad.definitions = catalog.definitions.duplicate()
	bad.definitions.append(catalog.definitions[0])
	check("duplicate ID rejected",not DB.new().configure(bad).ok)
	check("session database cannot silently replace stack limits",not db.configure(catalog).ok and db.stack_limit("water_bottle")==5)
	check("unknown ID returns no definition",db.definition("missing")==null)
	var inventory := Inventory.new(db)
	check("12 empty slots",inventory.slot_count()==12 and inventory.remaining_slots()==12)
	check("add splits at max stack",inventory.add_item("water_bottle",7).actual_quantity==7 and inventory.get_stack(0).quantity==5 and inventory.get_stack(1).quantity==2)
	check("add fills existing stack first",inventory.add_item("water_bottle",3).ok and inventory.get_stack(1).quantity==5 and inventory.remaining_slots()==10)
	check("different categories use own slots",inventory.add_item("battery",10).ok and inventory.get_stack(2).item_id=="battery" and inventory.get_stack(2).quantity==10)
	check("weapons never stack",inventory.add_item("combat_knife",2).ok and inventory.get_stack(3).quantity==1 and inventory.get_stack(4).quantity==1)
	check("capacity counts stack room plus free slots",inventory.capacity_for("water_bottle")==35)
	var stack = inventory.get_stack(0)
	stack.quantity = 1
	check("stack getter is detached",inventory.count_item("water_bottle")==10)
	var snapshot: Array = inventory.snapshot()
	snapshot[0].quantity = 1
	check("snapshot is detached",inventory.count_item("water_bottle")==10)
	check("remove consumes stable slots",inventory.remove_item("water_bottle",6).actual_quantity==6 and inventory.count_item("water_bottle")==4 and inventory.get_stack(0)==null)
	var old: Array = inventory.snapshot()
	check("insufficient removal changes nothing",not inventory.remove_item("water_bottle",5).ok and inventory.snapshot()==old)
	check("invalid/negative additions rejected",not inventory.add_item("missing",1).ok and not inventory.add_item("water_bottle",-1).ok and not inventory.add_item("water_bottle",0).ok and inventory.snapshot()==old)
	var full := Inventory.new(db)
	check("fill 12 nonstackable slots",full.add_item("combat_knife",12).ok and full.remaining_slots()==0 and full.capacity_for("combat_knife")==0)
	old = full.snapshot()
	check("full add has actual quantity zero",full.add_item("battery",1).actual_quantity==0 and full.snapshot()==old)
	var source := Inventory.new(db)
	source.add_item("water_bottle",2)
	source.add_item("bandage",2)
	var source_before: Array = source.snapshot()
	var notice := {"source":0,"target":0,"consistent":true,"reentrant_denied":false}
	source.changed.connect(func(_r): notice.source+=1; notice.consistent = full.count_item("water_bottle")==2 and source.count_item("water_bottle")==0; notice.reentrant_denied = not full.remove_item("water_bottle",1).ok)
	full.changed.connect(func(_r):notice.target+=1)
	check("full transfer rollback both inventories",not source.transfer_all_to(full).ok and full.snapshot()==old and source.snapshot()==source_before and notice.source==0 and notice.target==0)
	full.remove_item("combat_knife",1)
	notice.target = 0
	old = full.snapshot()
	check("multi item failure after first plan rolls back",not source.transfer_all_to(full).ok and full.snapshot()==old and source.snapshot()==source_before and notice.source==0 and notice.target==0)
	full.remove_item("combat_knife",1)
	notice.target = 0
	var result: Dictionary = source.transfer_all_to(full)
	check("whole transfer commits exact quantities",result.ok and result.actual_quantity==4 and result.items=={"water_bottle":2,"bandage":2} and source.contents().is_empty() and full.count_item("water_bottle")==2 and full.count_item("bandage")==2)
	check("observers see both committed and reentry locked",notice.source==1 and notice.target==1 and notice.consistent and notice.reentrant_denied)
	check("empty source cannot reward twice",not source.transfer_all_to(full).ok and full.count_item("water_bottle")==2 and notice.source==1)
	source.add_item("battery",2)
	var receiver := Inventory.new(db)
	check("transfer subset is atomic exact request",source.transfer_to(receiver,{"battery":1}).actual_quantity==1 and source.count_item("battery")==1 and receiver.count_item("battery")==1)
	receiver.remove_item("battery",1)
	check("source and receiver never share mutable stacks",source.count_item("battery")==1)
	old = source.snapshot()
	check("invalid float transfer rejected",not source.transfer_to(receiver,{"battery":0.5}).ok and source.snapshot()==old)
	check("self transfer rejected",not source.transfer_all_to(source).ok and source.snapshot()==old)
	var sender := Inventory.new(db)
	var recipient := Inventory.new(db)
	sender.add_item("battery",2)
	var request := {"battery":1}
	var callback := func(_r):request.battery = 99
	sender.changed.connect(callback)
	var isolated_result: Dictionary = sender.transfer_to(recipient,request)
	check("observer cannot corrupt transfer result request",isolated_result.items=={"battery":1} and isolated_result.actual_quantity==1 and recipient.count_item("battery")==1)
	sender.changed.disconnect(callback)
	for model in [source,full]:
		for connection in model.changed.get_connections(): model.changed.disconnect(connection.callable)
	var failures := checks.filter(func(c):return not c.passed).size()
	var f := FileAccess.open("res://stage6b3a/evidence/a24b/legacy_data.json",FileAccess.WRITE)
	f.store_string(JSON.stringify({"passed":checks.size()-failures,"failed":failures,"checks":checks},"\t"))
	quit(0 if failures==0 else 1)
